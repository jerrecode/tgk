BoxLayout:
    orientation: 'vertical'
    padding: 12
    Label:
        id: status
        text: 'Termux GUI + C / KV compatibility'
        font_size: 22
        height: 80
    TextInput:
        id: usertext
        text: 'Hello from Termux'
        multiline: False
        height: 60
    Button:
        text: 'Update label'
        height: 60
        on_release: app.update_status()
    CheckBox:
        id: enabled
        text: 'Enable option'
        active: True
    Label:
        id: slider_status
        text: 'Level: 65'
        height: 42
    Slider:
        id: level
        min: 0
        max: 100
        step: 1
        value: 65
        on_value: app.update_slider(self.value)
    ProgressBar:
        id: level_progress
        value: 65
    Button:
        text: 'Close'
        height: 56
        on_release: app.stop()
